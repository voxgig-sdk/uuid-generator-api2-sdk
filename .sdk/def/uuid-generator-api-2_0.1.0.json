{
  "openapi": "3.0.3",
  "info": {
    "title": "UUID Generator API",
    "description": "This API provides a fast and free method for generating UUIDs, supporting various versions including v1, v3, v4, v5, v6, and time-ordered v7. It allows bulk UUID generation with options for namespace and formatting, ideal for developers and websites. No authentication required, rate-limited for fair use.",
    "version": "1.0.0",
    "contact": {
      "name": "ToolkitVault",
      "url": "https://toolkitvault.com"
    },
    "license": {
      "name": "Public API",
      "url": "https://toolkitvault.com/uuid-generator/uuid-api-docs"
    }
  },
  "servers": [
    {
      "url": "https://toolkitvault.com",
      "description": "Production server"
    }
  ],
  "paths": {
    "/api/uuid-generator/v1": {
      "get": {
        "summary": "Generate UUID v1 (time-based)",
        "description": "Generate one or more UUID version 1 (time-based) identifiers",
        "operationId": "generateV1UuidQuery",
        "tags": [
          "UUID Generation"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CountQuery"
          },
          {
            "$ref": "#/components/parameters/FormatQuery"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/UuidSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/uuid-generator/v1/{count}": {
      "get": {
        "summary": "Generate UUID v1 with count in path",
        "description": "Generate multiple UUID version 1 identifiers with count specified in path",
        "operationId": "generateV1UuidPath",
        "tags": [
          "UUID Generation"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CountPath"
          },
          {
            "$ref": "#/components/parameters/FormatQuery"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/UuidSuccess"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
