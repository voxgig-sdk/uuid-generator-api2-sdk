# BasicGuidFlow

main: kit: flow: BasicGuidFlow:
{
  entity: "guid",
  kind: "basic",
  name: "BasicGuidFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "guid_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "guid_ref01",
        srcdatavar: "guid_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "guid01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-guid_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGuidFlow"
}