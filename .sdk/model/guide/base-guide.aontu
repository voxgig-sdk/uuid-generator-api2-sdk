# Guide

guide: {
  metrics: count: entity: 7
  metrics: count: path: 14
  metrics: count: method: 14

  entity: guid: {
    path: "/api/uuid-generator/guid": {
      op: list: method: *GET
      op: list: transform: res: *("`body.uuids`")|top
    }
    path: "/api/uuid-generator/guid/{count}": {
      rename: param: "count": *"id"
      op: load: method: *GET
    }
  }

